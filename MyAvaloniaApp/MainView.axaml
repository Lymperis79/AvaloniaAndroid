<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MyAvaloniaApp.MainView">
  <Grid RowDefinitions="Auto,*">
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="8" ColumnSpacing="8">
      <Button Grid.Column="0" Content="☰ Menu" Click="OnMenuClicked" />
      <TextBlock Grid.Column="1"
                 Text="Web Browser"
                 VerticalAlignment="Center"
                 HorizontalAlignment="Center"
                 FontSize="16" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
        <Button Content="‹" Click="OnBackClicked" />
        <Button Content="›" Click="OnForwardClicked" />
        <Button Content="↻" Click="OnReloadClicked" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1">
      <Grid x:Name="BrowserHost" />

      <Border x:Name="SettingsPanel"
              IsVisible="False"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Top"
              Margin="12"
              Padding="16"
              CornerRadius="10"
              Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
              BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
              BorderThickness="1"
              MaxWidth="520">
        <StackPanel Spacing="10">
          <TextBlock Text="Webpage settings" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Text="Enter the webpage address you want to save." TextWrapping="Wrap" />
          <TextBox x:Name="UrlBox"
                   Watermark="https://example.com"
                   HorizontalAlignment="Stretch" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Cancel" Click="OnCancelSettingsClicked" />
            <Button Content="Save and open" Click="OnSavePageClicked" />
          </StackPanel>
          <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
